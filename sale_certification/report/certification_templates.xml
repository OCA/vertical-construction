<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="report_certification">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <t t-set="sale_order" t-value="doc.order_id" />
                    <t
                        t-set="forced_vat"
                        t-value="sale_order.fiscal_position_id.foreign_vat"
                    />
                    <t t-set="address">
                        <div
                            t-field="sale_order.partner_id"
                            t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'
                        />
                        <p t-if="sale_order.partner_id.vat">
                            <t
                                t-if="sale_order.company_id.account_fiscal_country_id.vat_label"
                                t-out="sale_order.company_id.account_fiscal_country_id.vat_label"
                            />
                            <t t-else="">Tax ID</t>: <span
                                t-field="sale_order.partner_id.vat"
                            />
                        </p>
                    </t>
                    <t
                        t-if="sale_order.partner_shipping_id == sale_order.partner_invoice_id
                                        and sale_order.partner_invoice_id != sale_order.partner_id
                                        or sale_order.partner_shipping_id != sale_order.partner_invoice_id"
                    >
                        <t t-set="information_block">
                            <strong>
                                <t
                                    t-if="sale_order.partner_shipping_id == sale_order.partner_invoice_id"
                                >
                                    Invoicing and Shipping Address:
                                </t>
                                <t t-else="">
                                    Invoicing Address:
                                </t>
                            </strong>
                            <div
                                t-field="sale_order.partner_invoice_id"
                                t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "phone_icons": True}'
                            />
                            <t
                                t-if="sale_order.partner_shipping_id != sale_order.partner_invoice_id"
                            >
                                <strong>Shipping Address:</strong>
                                <div
                                    t-field="sale_order.partner_shipping_id"
                                    t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "phone_icons": True}'
                                />
                            </t>
                        </t>
                    </t>
                    <div class="page">

                        <h2 class="mt-4">
                            <span>Certification # </span>
                            <span t-field="doc.name">CERT/0000</span>
                        </h2>

                        <div class="row mt-4 mb-2" id="informations">
                            <div
                                t-if="doc.certification_date"
                                class="col-auto col-3 mw-100 mb-2"
                                name="informations_date"
                            >
                                <strong>Date:</strong><br />
                                <span
                                    class="m-0"
                                    t-field="doc.certification_date"
                                    t-options='{"widget": "datetime"}'
                                >2023-12-31</span>
                            </div>
                            <div
                                t-if="doc.company_id"
                                class="col-auto col-3 mw-100 mb-2"
                            >
                                <strong>Company:</strong><br />
                                <span
                                    class="m-0"
                                    t-field="doc.company_id"
                                >Mitchell Admin</span>
                            </div>
                        </div>

                        <t
                            t-set="lines_to_report"
                            t-value="doc.certification_line_ids"
                        />
                        <t
                            t-set="display_discount"
                            t-value="any(l.sale_line_ids.discount for l in lines_to_report)"
                        />
                        <table
                            class="table table-sm o_main_table table-borderless mt-4"
                        >
                            <thead style="display: table-row-group">
                                <tr>
                                    <th class="text-start">Description</th>
                                    <th class="text-end">Quantity</th>
                                    <th class="text-end">Unit Price</th>
                                    <th
                                        t-if="display_discount"
                                        class="text-end"
                                    >Disc.%</th>
                                    <th class="text-end">Taxes</th>
                                    <th class="text-end">Amount</th>
                                </tr>
                            </thead>
                            <tbody class="sale_tbody">
                                <t t-set="current_subtotal" t-value="0" />
                                <t t-foreach="lines_to_report" t-as="line">
                                    <t
                                        t-set="certified_amount"
                                        t-value="line.quantity * line.sale_line_ids.price_unit * (1 - line.sale_line_ids.discount / 100.0)"
                                    />
                                    <t
                                        t-set="current_subtotal"
                                        t-value="current_subtotal + certified_amount"
                                    />

                                    <tr
                                        t-att-class="'bg-200 fw-bold o_line_section' if line.display_type == 'line_section' else 'fst-italic bg-100 fw-bold o_line_note' if line.display_type == 'line_note' else ''"
                                    >
                                        <t t-if="not line.display_type">
                                            <td><span t-field="line.name" /></td>
                                            <td class="text-end">
                                                <span t-field="line.quantity" />
                                                <span t-field="line.product_uom_id" />
                                            </td>
                                            <td class="text-end">
                                                <span
                                                    t-field="line.sale_line_ids.price_unit"
                                                />
                                            </td>
                                            <td
                                                t-if="display_discount"
                                                class="text-end"
                                            >
                                                <span
                                                    t-field="line.sale_line_ids.discount"
                                                />
                                            </td>
                                            <td class="text-end">
                                                <span
                                                    t-out="', '.join([(tax.invoice_label or tax.name) for tax in line.sale_line_ids.tax_id])"
                                                />
                                            </td>
                                            <td class="text-end o_price_total">
                                                <span
                                                    t-out="certified_amount"
                                                    t-options='{"widget": "monetary", "display_currency": sale_order.currency_id}'
                                                />
                                            </td>
                                        </t>
                                        <t t-elif="line.display_type == 'line_section'">
                                            <td colspan="99">
                                                <span t-field="line.name" />
                                            </td>
                                        </t>
                                        <t t-elif="line.display_type == 'line_note'">
                                            <td colspan="99">
                                                <span t-field="line.name" />
                                            </td>
                                        </t>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <t
                            t-set="total_untaxed"
                            t-value="sum(
                            line.quantity * line.sale_line_ids.price_unit * (1 - line.sale_line_ids.discount / 100.0)
                            for line in lines_to_report
                            if not line.display_type
                        )"
                        />
                        <t
                            t-set="total_taxes"
                            t-value="sum(
                            (line.quantity / (line.sale_line_ids.product_uom_qty or 1)) * line.sale_line_ids.price_tax
                            for line in lines_to_report
                            if not line.display_type
                        )"
                        />
                        <t t-set="cert_total" t-value="total_untaxed + total_taxes" />

                        <div class="clearfix" name="so_total_summary">
                            <div class="row">
                                <div class="col-sm-7 col-md-6 ms-auto">
                                    <table class="table table-sm table-borderless">
                                        <tr class="border-black o_subtotal">
                                            <td><strong>Untaxed Amount</strong></td>
                                            <td class="text-end">
                                                <span
                                                    t-out="total_untaxed"
                                                    t-options='{"widget": "monetary", "display_currency": sale_order.currency_id}'
                                                />
                                            </td>
                                        </tr>
                                        <tr>
                                            <td><strong>Taxes</strong></td>
                                            <td class="text-end">
                                                <span
                                                    t-out="total_taxes"
                                                    t-options='{"widget": "monetary", "display_currency": sale_order.currency_id}'
                                                />
                                            </td>
                                        </tr>
                                        <tr class="border-black o_total">
                                            <td><strong>Total</strong></td>
                                            <td class="text-end">
                                                <span
                                                    t-out="cert_total"
                                                    t-options='{"widget": "monetary", "display_currency": sale_order.currency_id}'
                                                />
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <t t-if="sale_order.certification_ids">
                            <t t-set="today" t-value="datetime.datetime.now()" />
                            <t t-set="first_day" t-value="today.replace(day=1)" />

                            <t
                                t-set="all_certs"
                                t-value="sale_order.certification_ids.sorted('certification_date', reverse=True).filtered(lambda c: c.state != 'cancel')"
                            />
                            <t
                                t-set="prev_certs"
                                t-value="all_certs.filtered(lambda c: c.certification_date and c.name != doc.name and c.certification_date &lt; first_day)"
                            />
                            <t
                                t-set="current_certs"
                                t-value="all_certs.filtered(lambda c: c.certification_date and c.name != doc.name and c.certification_date &gt;= first_day and c.certification_date &lt; today)"
                            />

                            <div class="mt-4 mb-4">
                                <div class="col-12">
                                    <table
                                        class="table table-bordered table-sm o_main_table"
                                    >
                                        <thead class="bg-200">
                                            <tr>
                                                <th
                                                    class="text-center py-2"
                                                >Sale Order</th>
                                                <th
                                                    class="text-center py-2"
                                                >Last Months</th>
                                                <th
                                                    class="text-center py-2"
                                                >Current Month</th>
                                                <th
                                                    class="text-center py-2"
                                                >Nowadays</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <!-- Sale Order Column -->
                                                <td class="p-3">
                                                    <table
                                                        class="table-borderless-cert w-100"
                                                        style="border-bottom: 1px solid;"
                                                    >
                                                        <tr class="text-center">
                                                            <td class="text-start">
                                                                <span
                                                                    t-field="sale_order.name"
                                                                />
                                                            </td>
                                                            <td class="text-end">
                                                                <span
                                                                    t-out="sale_order.amount_untaxed"
                                                                    t-options='{"widget": "monetary", "display_currency": sale_order.currency_id}'
                                                                />
                                                            </td>
                                                        </tr>
                                                    </table>
                                                </td>

                                                <!-- Last Months Column -->
                                                <td class="p-3">
                                                    <table
                                                        class="table-borderless-cert w-100"
                                                    >
                                                        <t
                                                            t-foreach="prev_certs"
                                                            t-as="cert"
                                                        >
                                                            <tr
                                                                style="border-bottom: 1px solid;"
                                                            >
                                                                <td class="text-start">
                                                                    <span
                                                                        t-field="cert.name"
                                                                    />
                                                                </td>
                                                                <td class="text-end">
                                                                    <span
                                                                        t-out="sum(
                                                                        line.quantity * line.sale_line_ids.price_unit * (1 - line.sale_line_ids.discount / 100.0)
                                                                        for line in cert.certification_line_ids if not line.display_type
                                                                    )"
                                                                        t-options='{"widget": "monetary", "display_currency": sale_order.currency_id}'
                                                                    />
                                                                </td>
                                                            </tr>
                                                        </t>
                                                    </table>
                                                </td>

                                                <!-- Current Month Column -->
                                                <td class="p-3">
                                                    <table
                                                        class="table-borderless-cert w-100"
                                                    >
                                                        <t
                                                            t-foreach="current_certs"
                                                            t-as="cert"
                                                        >
                                                            <tr
                                                                style="border-bottom: 1px solid;"
                                                            >
                                                                <td class="text-start">
                                                                    <span
                                                                        t-field="cert.name"
                                                                    />
                                                                </td>
                                                                <td class="text-end">
                                                                    <span
                                                                        t-out="sum(
                                                                            line.quantity * line.sale_line_ids.price_unit * (1 - line.sale_line_ids.discount / 100.0)
                                                                            for line in cert.certification_line_ids if not line.display_type
                                                                        )"
                                                                        t-options='{"widget": "monetary", "display_currency": sale_order.currency_id}'
                                                                    />
                                                                </td>
                                                            </tr>
                                                        </t>
                                                    </table>
                                                </td>

                                                <!-- Nowdays Column -->
                                                <td class="p-3">
                                                    <table
                                                        class="table-borderless-cert w-100"
                                                    >
                                                        <t
                                                            t-foreach="all_certs"
                                                            t-as="cert"
                                                        >
                                                            <tr
                                                                style="border-bottom: 1px solid;"
                                                            >
                                                                <td class="text-start">
                                                                    <span
                                                                        t-field="cert.name"
                                                                    />
                                                                </td>
                                                                <td class="text-end">
                                                                    <span
                                                                        t-out="sum(
                                                                        line.quantity * line.sale_line_ids.price_unit * (1 - line.sale_line_ids.discount / 100.0)
                                                                        for line in cert.certification_line_ids if not line.display_type
                                                                    )"
                                                                        t-options='{"widget": "monetary", "display_currency": sale_order.currency_id}'
                                                                    />
                                                                </td>
                                                            </tr>
                                                        </t>
                                                    </table>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td class="p-3">
                                                    <table
                                                        class="table-borderless-cert w-100"
                                                    >
                                                        <tr>
                                                            <td class="text-start"><span
                                                                >Untaxed:</span></td>
                                                            <td class="text-end">
                                                                <span
                                                                    t-out="sale_order.amount_untaxed"
                                                                    t-options='{"widget": "monetary", "display_currency": sale_order.currency_id}'
                                                                />
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td class="text-start"><span
                                                                >Taxes:</span></td>
                                                            <td class="text-end">
                                                                <span
                                                                    t-out="sale_order.amount_tax"
                                                                    t-options='{"widget": "monetary", "display_currency": sale_order.currency_id}'
                                                                />
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td
                                                                class="text-start fw-bold"
                                                            ><span>Total:</span></td>
                                                            <td
                                                                class="text-end fw-bold"
                                                            >
                                                                <span
                                                                    t-out="sale_order.amount_total"
                                                                    t-options='{"widget": "monetary", "display_currency": sale_order.currency_id}'
                                                                />
                                                            </td>
                                                        </tr>
                                                    </table>
                                                </td>
                                                <td class="p-3">
                                                    <table
                                                        class="table-borderless-cert w-100"
                                                    >
                                                        <tr>
                                                            <td class="text-start"><span
                                                                >Untaxed:</span></td>
                                                            <td class="text-end">
                                                                <span
                                                                    t-out="sum(
                                                                    line.quantity * line.sale_line_ids.price_unit * (1 - line.sale_line_ids.discount / 100.0)
                                                                    for cert in prev_certs
                                                                    for line in cert.certification_line_ids
                                                                    if not line.display_type
                                                                )"
                                                                    t-options='{"widget": "monetary", "display_currency": sale_order.currency_id}'
                                                                />
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td class="text-start"><span
                                                                >Taxes:</span></td>
                                                            <td class="text-end">
                                                                <span
                                                                    t-out="sum(
                                                                    (line.quantity / (line.sale_line_ids.product_uom_qty or 1)) * line.sale_line_ids.price_tax
                                                                    for cert in prev_certs
                                                                    for line in cert.certification_line_ids
                                                                    if not line.display_type
                                                                )"
                                                                    t-options='{"widget": "monetary", "display_currency": sale_order.currency_id}'
                                                                />
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td
                                                                class="text-start fw-bold"
                                                            ><span>Total:</span></td>
                                                            <td
                                                                class="text-end fw-bold"
                                                            >
                                                                <span
                                                                    t-out="sum(
                                                                    (line.quantity * line.sale_line_ids.price_unit * (1 - line.sale_line_ids.discount / 100.0)) +
                                                                    ((line.quantity / (line.sale_line_ids.product_uom_qty or 1)) * line.sale_line_ids.price_tax)
                                                                    for cert in prev_certs
                                                                    for line in cert.certification_line_ids
                                                                    if not line.display_type
                                                                )"
                                                                    t-options='{"widget": "monetary", "display_currency": sale_order.currency_id}'
                                                                />
                                                            </td>
                                                        </tr>
                                                    </table>
                                                </td>
                                                <td class="p-3">
                                                    <table
                                                        class="table-borderless-cert w-100"
                                                    >
                                                        <tr>
                                                            <td class="text-start"><span
                                                                >Untaxed:</span></td>
                                                            <td class="text-end">
                                                                <span
                                                                    t-out="sum(
                                                                    line.quantity * line.sale_line_ids.price_unit * (1 - line.sale_line_ids.discount / 100.0)
                                                                    for cert in current_certs for line in cert.certification_line_ids if not line.display_type
                                                                )"
                                                                    t-options='{"widget": "monetary", "display_currency": sale_order.currency_id}'
                                                                />
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td class="text-start"><span
                                                                >Taxes:</span></td>
                                                            <td class="text-end">
                                                                <span
                                                                    t-out="sum(
                                                                    (line.quantity / (line.sale_line_ids.product_uom_qty or 1)) * line.sale_line_ids.price_tax
                                                                    for cert in current_certs for line in cert.certification_line_ids if not line.display_type
                                                                )"
                                                                    t-options='{"widget": "monetary", "display_currency": sale_order.currency_id}'
                                                                />
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td
                                                                class="text-start fw-bold"
                                                            ><span>Total:</span></td>
                                                            <td
                                                                class="text-end fw-bold"
                                                            >
                                                                <span
                                                                    t-out="sum(
                                                                    (line.quantity * line.sale_line_ids.price_unit * (1 - line.sale_line_ids.discount / 100.0)) +
                                                                    ((line.quantity / (line.sale_line_ids.product_uom_qty or 1)) * line.sale_line_ids.price_tax)
                                                                    for cert in current_certs for line in cert.certification_line_ids if not line.display_type
                                                                )"
                                                                    t-options='{"widget": "monetary", "display_currency": sale_order.currency_id}'
                                                                />
                                                            </td>
                                                        </tr>
                                                    </table>
                                                </td>
                                                <td class="p-3">
                                                    <table
                                                        class="table-borderless-cert w-100"
                                                    >
                                                        <tr>
                                                            <td class="text-start"><span
                                                                >Untaxed:</span></td>
                                                            <td class="text-end">
                                                                <span
                                                                    t-out="sum(
                                                                    line.quantity * line.sale_line_ids.price_unit * (1 - line.sale_line_ids.discount / 100.0)
                                                                    for cert in all_certs for line in cert.certification_line_ids if not line.display_type
                                                                )"
                                                                    t-options='{"widget": "monetary", "display_currency": sale_order.currency_id}'
                                                                />
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td class="text-start"><span
                                                                >Taxes:</span></td>
                                                            <td class="text-end">
                                                                <span
                                                                    t-out="sum(
                                                                    (line.quantity / (line.sale_line_ids.product_uom_qty or 1)) * line.sale_line_ids.price_tax
                                                                    for cert in all_certs for line in cert.certification_line_ids if not line.display_type
                                                                )"
                                                                    t-options='{"widget": "monetary", "display_currency": sale_order.currency_id}'
                                                                />
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td
                                                                class="text-start fw-bold"
                                                            ><span>Total:</span></td>
                                                            <td
                                                                class="text-end fw-bold"
                                                            >
                                                                <span
                                                                    t-out="sum(
                                                                    (line.quantity * line.sale_line_ids.price_unit * (1 - line.sale_line_ids.discount / 100.0)) +
                                                                    ((line.quantity / (line.sale_line_ids.product_uom_qty or 1)) * line.sale_line_ids.price_tax)
                                                                    for cert in all_certs for line in cert.certification_line_ids if not line.display_type
                                                                )"
                                                                    t-options='{"widget": "monetary", "display_currency": sale_order.currency_id}'
                                                                />
                                                            </td>
                                                        </tr>
                                                    </table>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
